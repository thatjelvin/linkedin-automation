# ===================================
# LinkedIn AI/ML Automation - Environment Variables
# ===================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control!

# ===================================
# GOOGLE SHEETS CONFIGURATION
# ===================================
# Google Sheets Document ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/YOUR_DOC_ID/edit
GOOGLE_SHEETS_DOC_ID=

# Google Sheets Tab Name (default: PostHistory)
GOOGLE_SHEETS_SHEET_NAME=PostHistory

# ===================================
# GROQ AI CONFIGURATION (FREE)
# ===================================
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=

# ===================================
# TAVILY SEARCH API (FREE)
# ===================================
# Get your free API key from: https://tavily.com/
TAVILY_API_KEY=

# ===================================
# UNSPLASH IMAGES (FREE)
# ===================================
# Get your free access key from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# ===================================
# LINKEDIN CONFIGURATION
# ===================================
# LinkedIn Person URN (format: urn:li:person:XXXXXXXXXX)
# You can find this by going to your LinkedIn profile and checking the URL
# Example: https://www.linkedin.com/in/your-profile/ -> Person URN is needed from API
LINKEDIN_PERSON_URN=

# ===================================
# EMAIL ALERTS (OPTIONAL - for error notifications)
# ===================================
# Email address to receive error notifications
ALERT_EMAIL=

# SMTP Server Configuration (if using email alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
